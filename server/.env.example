# Port to run the server on (Render sets this dynamically via process.env.PORT)
PORT=5000

# Nodemailer SMTP Configuration for sending email dispatches
# Use your Gmail address and Google App Password (not your account password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# The destination email address where you want to receive recruiter notifications
RECEIVER_EMAIL=therockstarop9956@gmail.com
